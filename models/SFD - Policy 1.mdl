{UTF-8}
Platform Comission=IF THEN ELSE(Time > 15, 0.2, 0.35)
	~	Dmnl
	~		|

Average Fare=Reference Fare Value(Time/one month)*(Total Demand/(Number of Drivers*(SMOOTH\
		 ( Driver's Share of Demand per Month , dsod delay ) +SMOOTH ( Driver's Share of Demand per Month\
		 , dsod delay * 2.5 ) +SMOOTH ( Driver's Share of Demand per Month , dsod delay * 4\
		 ) ) / 3))
	~	$/trip
	~		|

Average Daily Working Hours per Driver=(1-Average Tenure Effect)*Reference Working Hours\
		*(Average Target Income (Time/one month)/(
	SMOOTH(
	Average Monthly Net Earnings, income perception delay)
	))+Average Tenure Effect*Reference Working Hours*(SMOOTH(Average Fare, income perception delay\
		)/Reference Fare Value
	 (Time/one month)
	)
	~	hour
	~		|

Increase in Demand Rate=base increase rate * Total Demand * ((Reference Fare Value (Time\
		/one month) / SMOOTH(Average Fare,
	 order value delay
	)) 
	^ 0.7) * ((Reference Waiting Time
	 / SMOOTH(Average Waiting Time per Order, waiting time delay)
	) ^ 0.5)
	~	trip/Month/Month
	~		|

Average Monthly Net Earnings= ACTIVE INITIAL ((1-Platform Comission)*Average Monthly Gross Earnings\
		-(Driver's Share of Demand per Month
	*Average Operating Cost per Order (Time/one month))+(Tips and Other Expenses(Time/one month\
		)*Driver's Share of Demand per Month),
		2607.28)
	~	$/Month/driver
	~		|

Platform Attractiveness= ACTIVE INITIAL ((Average Monthly Net Earnings / (Unemployment Insurance\
		 (Time/one month))) * EXP(-hours penalty coef
	 * Average Daily Working Hours per Driver
	),
		0.7)
	~	Dmnl
	~		|

Decrease in Demand Rate=base decrease rate * Total Demand * ((SMOOTH(Average Fare, order value delay\
		) / Reference Fare Value
	 (Time/one month)
	) ^ 0.7) * ((SMOOTH(Average Waiting Time per Order, waiting time delay)
	 / Reference Waiting Time) ^ 0.5)
	~	trip/Month/Month
	~		|

Average Tenure Effect=1 / (1 + EXP( - tenure coef * (Average Tenure - Reference Average Tenure\
		) ))
	~	Dmnl
	~		|

one month=1
	~	Month
	~		|

Join Rate=(Unemployed Population(Time/one month))*join rate coef*SMOOTH(Platform Attractiveness\
		, attractiveness delay)
	~	driver/Month
	~		|

income perception delay=0.2
	~	Month
	~		|

attractiveness delay=0.4
	~	Month
	~		|

join rate coef=0.026601
	~	driver/people/Month
	~		|

churn rate coef=0.077578
	~	1/Month
	~		|

order value delay=0.2
	~	Month
	~		|

base increase rate=0.027645
	~	1/Month
	~		|

Reference Average Tenure=15
	~	Month
	~		|

Average Waiting Time per Order=Reference Waiting Time * EXP( 1 - Number of Drivers / \
		( ( SMOOTH ( Number of Drivers , nod delay ) + SMOOTH ( Number of Drivers , nod delay\
		 * 2.5 ) + SMOOTH ( Number of Drivers , nod delay * 4 ) ) / 3 ) )
	~	second/trip
	~		|

base decrease rate=0.02
	~	1/Month
	~		|

Churn Rate=Number of Drivers*churn rate coef/SMOOTH(Platform Attractiveness,attractiveness delay\
		)
	~	driver/Month
	~		|

tenure coef=0.25
	~	1/Month
	~		|

dsod delay=0.2
	~	Month
	~		|

Reference Waiting Time=240
	~	second/trip
	~		|

hours penalty coef=0.08
	~	1/hour
	~		|

waiting time delay=0.5
	~	Month
	~		|

nod delay=0.2
	~	Month
	~		|

Average Monthly Gross Earnings=Average Fare*Driver's Share of Demand per Month
	~	$/Month/driver
	~		|

